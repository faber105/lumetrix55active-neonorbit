PROJECT_NAME=AlphaPulse OTC

# Telegram
BOT_TOKEN=put_your_bot_token_here
ADMIN_TELEGRAM_ID=123456789
MINI_APP_URL=https://your-mini-app.example
PUBLIC_API_BASE_URL=https://your-api.example
MINI_APP_API_BASE_URL=https://your-api.example/api
REFERRAL_URL=https://your-pocket-option-affiliate-link.example
SUPPORT_USERNAME=your_support_username
SIGNAL_TIMEZONE=Europe/Rome
MAX_VERIFICATION_ATTEMPTS=3
MIN_REGISTRATION_SECONDS=120
REQUIRE_SUBSCRIPTION_FOR_SIGNALS=false

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/signals_db

# Security
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_TOKEN=replace_with_a_long_random_admin_token
JWT_EXPIRES_HOURS=24

# Pocket Option OTC read-only market stream
# IMPORTANT: do not commit this value. It is a browser session credential.
POCKET_OPTION_SSID=
POCKET_OPTION_DEMO=true
OTC_DATA_PROVIDER=pocketoptionapi_async

# OTC scanner
OTC_ASSETS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,AUDUSD_otc,USDCAD_otc,EURGBP_otc,EURJPY_otc,AUDCAD_otc,AUDCHF_otc,NZDUSD_otc
OTC_TIMEFRAMES=1m,3m,5m
SCAN_INTERVAL_SECONDS=15
CONFIDENCE_THRESHOLD=0.72
STRATEGY_THRESHOLD=0.62
ML_WEIGHT=0.25
MAX_ACTIVE_SIGNALS=12
SIGNAL_COOLDOWN_SECONDS=120
ENTRY_LEAD_SECONDS=5
MODEL_DIR=models_online
ONLINE_ML_MIN_SAMPLES=40

# Optional legacy payment settings
CRYPTOBOT_API_TOKEN=
USDT_TRC20_WALLET=
CF_TUNNEL_TOKEN=
