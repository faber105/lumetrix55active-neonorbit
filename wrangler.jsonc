{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumetrix55active-neonorbit",
  "main": "./cloudflare/relay.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./miniapp/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__bridge/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "AlphaPulseRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AlphaPulseRelay"]
    }
  ]
}
