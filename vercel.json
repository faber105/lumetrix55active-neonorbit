{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix miniapp install --no-audit --no-fund && npm --prefix miniapp run build && python scripts/diagnose_runtime_import.py && python scripts/set_telegram_webhook.py",
  "outputDirectory": "miniapp/dist",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/telegram/webhook",
      "destination": "/api/telegram/webhook"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/home/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/signals/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/market/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/stats/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/settings/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/live/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/auto/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/auto-preload/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/admin-stats/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/internal/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/ws/:path*",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "miniapp/dist/**"
    },
    "api/telegram/webhook.py": {
      "maxDuration": 60
    },
    "api/health.py": {
      "maxDuration": 30
    }
  }
}
