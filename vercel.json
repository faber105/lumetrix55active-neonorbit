{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix miniapp install --no-audit --no-fund && npm --prefix miniapp run build",
  "outputDirectory": "miniapp/dist",
  "functions": {
    "api/main.py": {
      "maxDuration": 300,
      "includeFiles": "{runtime_secrets.json,miniapp/dist/**}"
    }
  }
}